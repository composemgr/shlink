# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=shlink.example.com

APP_ORG_NAME=Shlink

DB_USER_NAME=shlink
DB_USER_PASS=replace-with-a-random-password
DB_ADMIN_PASS=replace-with-a-random-password
DB_CREATE_DATABASE_NAME=shlink

# Initial API key handed out on an empty database, minimum 32 characters.
# Generate with: openssl rand -hex 32
APP_API_TOKEN=replace-with-a-random-32-char-string

# MaxMind GeoLite2 license key, required for geolocation on visits.
# Get one from https://www.maxmind.com/en/accounts/current/license-key
GEOLITE_LICENSE_KEY=

# Length of the randomly generated short codes
SHLINK_SHORT_CODES_LENGTH=6

# HTTP status code used when a short URL is visited, 301 or 302
SHLINK_REDIRECT_STATUS_CODE=301

# Where users land when a short code does not exist, leave empty for the
# default not-found page
DEFAULT_INVALID_SHORT_URL_REDIRECT=

# Point at a Redis instance to speed up long URLs, e.g. redis://redis:6379
REDIS_SERVERS=
