# Shlink - Self-hosted URL shortener
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# Hostname / Domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Database credentials
DB_CREATE_DATABASE_NAME=shlink
DB_USER_NAME=shlink
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# API token for initial access (must be at least 32 characters)
APP_API_TOKEN=changeme_api_token_min_32_chars

# GeoLite2 license key for geolocation (optional, get from MaxMind)
GEOLITE_LICENSE_KEY=

# URL for invalid/not found short URLs redirect (optional)
DEFAULT_INVALID_SHORT_URL_REDIRECT=
